FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/catalog-worker ./cmd/catalog-worker

FROM alpine:3.21
COPY --from=build /out/catalog-worker /usr/local/bin/catalog-worker
ENTRYPOINT ["catalog-worker"]