FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/importer ./cmd/importer

FROM alpine:3.21
COPY --from=build /out/importer /usr/local/bin/importer
EXPOSE 8080
ENTRYPOINT ["importer"]